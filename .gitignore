# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jesse runtime data (local, private — never commit)
*.db
*.sqlite
*.sqlite3
data/
models/
*.wav
*.onnx
.env

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# The remote-access token. Covered by data/ already; named explicitly because a
# leaked secret is not the place to rely on an inherited rule.
data/remote-token.txt
*remote-token*

# The self-signed cert and its private key. data/ covers them; named explicitly
# because a private key is not the place to rely on an inherited rule.
data/remote-cert.pem
data/remote-key.pem
*remote-key*
